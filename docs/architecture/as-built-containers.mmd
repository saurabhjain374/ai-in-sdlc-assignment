flowchart TB
    caller["Approver / Admin caller"]

    subgraph host["AS-BUILT | ASP.NET Core application"]
        direction TB

        subgraph api["API LAYER"]
            direction LR
            middleware["SessionAuthMiddleware"]
            session[("SessionStore")]
            controllers["InvoicesController<br/>ApprovalsController"]
        end

        subgraph domain["DOMAIN LAYER"]
            direction LR
            service["ApprovalService"]
            repoContract["IInvoiceRepository"]
            invoice["Invoice / InvoiceStatus"]
        end

        repo[("InMemoryInvoiceRepository")]
    end

    caller -->|HTTP requests| middleware
    middleware --> controllers
    middleware --- session
    controllers --> service
    controllers --> repoContract
    service --> repoContract
    repoContract -. "implements" .-> repo
    service --> invoice
    repo --> invoice

