{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python scripts/ai_augmentation_logger.py",
        "windows": "py -3 scripts\\ai_augmentation_logger.py",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python scripts/ai_augmentation_logger.py",
        "windows": "py -3 scripts\\ai_augmentation_logger.py",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python scripts/ai_augmentation_logger.py",
        "windows": "py -3 scripts\\ai_augmentation_logger.py",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python scripts/ai_augmentation_logger.py",
        "windows": "py -3 scripts\\ai_augmentation_logger.py",
        "timeout": 5
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "python scripts/ai_augmentation_logger.py",
        "windows": "py -3 scripts\\ai_augmentation_logger.py",
        "timeout": 5
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "python scripts/ai_augmentation_logger.py",
        "windows": "py -3 scripts\\ai_augmentation_logger.py",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/ai_augmentation_logger.py",
        "windows": "py -3 scripts\\ai_augmentation_logger.py",
        "timeout": 5
      }
    ]
  }
}
